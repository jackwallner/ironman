    "Episodes are saved the first time you watch them so they play offline. Clearing them just means the next play downloads again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folgen werden beim ersten Ansehen gespeichert, damit sie offline laufen. Nach dem Löschen werden sie beim nächsten Abspielen neu geladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los episodios se guardan la primera vez que los ves para reproducirlos sin conexión. Si los borras, se volverán a descargar al reproducirlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les épisodes sont enregistrés au premier visionnage pour être lus hors ligne. Si vous les effacez, ils seront simplement retéléchargés à la prochaine lecture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli episodi vengono salvati alla prima visione per funzionare offline. Se li elimini, verranno riscaricati alla prossima riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エピソードは最初に見たときに保存され、オフラインで再生できます。削除しても、次回再生時にまたダウンロードされるだけです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afleveringen worden bij de eerste keer kijken bewaard, zodat ze offline werken. Wis je ze, dan worden ze de volgende keer opnieuw gedownload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odcinki zapisują się przy pierwszym obejrzeniu, więc działają offline. Po usunięciu zostaną pobrane ponownie przy następnym odtworzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os episódios são salvos na primeira vez que você assiste, para tocar offline. Se apagar, eles só serão baixados de novo na próxima vez."
          }
        }
      }
    },
