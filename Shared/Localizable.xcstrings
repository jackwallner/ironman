    "Put two full distance finishes side by side and see every leg's gain or loss." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell zwei Langdistanz-Finishes nebeneinander und sieh in jeder Disziplin den Gewinn oder Verlust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara dos carreras de larga distancia y mira cuánto ganaste o perdiste en cada segmento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparez deux longues distances côte à côte et voyez le temps gagné ou perdu dans chaque discipline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti a confronto due gare su distanza lunga e scopri quanto hai guadagnato o perso in ogni frazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フルディスタンスの完走を2つ並べて、種目ごとに縮めたタイムと遅れたタイムを確認できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet twee hele afstanden naast elkaar en zie per onderdeel wat je won of verloor."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zestaw obok siebie dwa ukończone pełne dystanse i zobacz zysk lub stratę na każdym etapie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque duas provas de longa distância lado a lado e veja o que ganhou ou perdeu em cada modalidade."
          }
        }
      }
    },
