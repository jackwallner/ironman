    "Official times are shown as published by the event timer. Race notes stay on this phone and are included only when you choose to export." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offizielle Zeiten werden so angezeigt, wie die Zeitnahme sie veröffentlicht hat. Rennnotizen bleiben auf diesem iPhone und werden nur exportiert, wenn du es auswählst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tiempos oficiales se muestran tal como los publica el cronometraje. Las notas no salen de este iPhone y solo se incluyen si decides exportarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les temps officiels sont affichés tels que publiés par le chronométreur. Vos notes restent sur cet iPhone et ne sont incluses que si vous choisissez de les exporter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tempi ufficiali sono mostrati come pubblicati dal cronometraggio. Le note restano su questo iPhone e vengono incluse solo se scegli di esportarle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公式タイムは大会の計測業者が公開したとおりに表示されます。レースメモはこのiPhoneに保存され、書き出しを選んだときだけ含まれます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Officiële tijden worden getoond zoals de tijdwaarneming ze publiceert. Notities blijven op deze iPhone en gaan alleen mee als je ze exporteert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oficjalne czasy są pokazywane tak, jak opublikował je pomiar czasu. Notatki zostają na tym iPhonie i trafiają do eksportu tylko, jeśli je wybierzesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os tempos oficiais aparecem como publicados pela cronometragem. As notas ficam neste iPhone e só entram se você decidir exportar."
          }
        }
      }
    },
