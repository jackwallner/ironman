    "See exactly where one like-for-like race gained or lost time against another." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh genau, wo ein vergleichbares Rennen gegenüber einem anderen Zeit gewonnen oder verloren hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira exactamente dónde ganaste o perdiste tiempo entre dos carreras equivalentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez précisément où vous avez gagné ou perdu du temps d’une course équivalente à l’autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scopri esattamente dove hai guadagnato o perso tempo tra due gare equivalenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ条件の2つのレースで、どこでタイムを縮め、どこで遅れたかがわかります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie precies waar je tijd won of verloor tussen twee gelijkwaardige races."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobacz dokładnie, gdzie jeden równoważny start zyskał lub stracił czas względem drugiego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja exatamente onde você ganhou ou perdeu tempo entre duas provas equivalentes."
          }
        }
      }
    },
    "See the best of your career, where your time is moving, and what each race contributed. Compare and export with one lifetime unlock." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh die Highlights deiner Karriere, wohin sich deine Zeiten entwickeln und was jedes Rennen beigetragen hat. Vergleichen und Exportieren mit einem einmaligen Kauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira lo mejor de tu trayectoria, hacia dónde van tus tiempos y qué aportó cada carrera. Compara y exporta con un único pago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrouvez le meilleur de votre parcours, l’évolution de vos temps et l’apport de chaque course. Comparez et exportez avec un achat unique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivedi il meglio della tua carriera, come cambiano i tuoi tempi e cosa ha dato ogni gara. Confronta ed esporta con un unico acquisto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャリアのハイライト、タイムの推移、各レースの成果をひと目で。比較と書き出しは1回の購入でずっと使えます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie het beste van je carrière, waar je tijden heen gaan en wat elke race bijdroeg. Vergelijk en exporteer met één eenmalige aankoop."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobacz najlepsze chwile kariery, w którą stronę idą Twoje czasy i co wniósł każdy start. Porównuj i eksportuj dzięki jednorazowemu odblokowaniu."
          }
