          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Einmaliger Kauf. Dauerhafter Zugriff auf Race Book. Kein Abo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Pago único. Acceso de por vida a Race Book. Sin suscripción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Achat unique. Accès à vie à Race Book. Sans abonnement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Acquisto unico. Accesso a vita a Race Book. Nessun abbonamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。買い切り。Race Bookをずっと使えます。サブスクリプションなし。"
