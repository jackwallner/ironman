    "Many racers share this name. Add a city or state after a comma, for example John Smith, Madison." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viele Athleten tragen diesen Namen. Füge nach einem Komma eine Stadt oder ein Bundesland hinzu, zum Beispiel Max Müller, Hamburg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muchos deportistas comparten este nombre. Añade una ciudad o provincia tras una coma, por ejemplo Juan García, Valencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs athlètes portent ce nom. Ajoutez une ville ou une région après une virgule, par exemple Jean Martin, Nice."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Molti atleti hanno questo nome. Aggiungi una città o una regione dopo una virgola, per esempio Marco Rossi, Bologna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ名前の選手が多くいます。カンマの後に都市名や州名を加えてください。例：Taro Yamada, Tokyo"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veel atleten hebben deze naam. Zet na een komma een plaats of provincie, bijvoorbeeld Jan de Vries, Utrecht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wielu zawodników ma to samo nazwisko. Dodaj miasto lub region po przecinku, na przykład Jan Kowalski, Poznań."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muitos atletas têm este nome. Adicione uma cidade ou estado depois de uma vírgula, por exemplo João Silva, Florianópolis."
          }
        }
      }
    },
