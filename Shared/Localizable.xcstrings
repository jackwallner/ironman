    "Courses vary. A like-for-like event comparison will appear after another finish at the same race." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strecken sind unterschiedlich. Ein Vergleich desselben Rennens erscheint nach einem weiteren Finish beim gleichen Event."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recorridos cambian. La comparativa de la misma prueba aparecerá cuando vuelvas a terminarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les parcours diffèrent. Une comparaison sur la même épreuve apparaîtra quand vous l’aurez terminée une nouvelle fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I percorsi cambiano. Il confronto sulla stessa gara apparirà quando la concluderai di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コースはレースごとに異なります。同じ大会をもう一度完走すると、同条件の比較が表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcoursen verschillen. Een vergelijking van dezelfde race verschijnt zodra je die nog eens uitloopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasy się różnią. Porównanie tych samych zawodów pojawi się po kolejnym ukończeniu tego startu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os percursos mudam. A comparação da mesma prova aparece quando você concluí-la de novo."
          }
        }
      }
    },
    "Courses vary. Choose a repeat event above for a like-for-like view." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strecken sind unterschiedlich. Wähle oben ein wiederholtes Rennen für einen direkten Vergleich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recorridos cambian. Elige arriba una prueba repetida para compararla de igual a igual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les parcours diffèrent. Choisissez ci-dessus une épreuve courue plusieurs fois pour une comparaison équivalente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I percorsi cambiano. Scegli sopra una gara ripetuta per un confronto equivalente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コースはレースごとに異なります。上で複数回出場した大会を選ぶと、同条件で比較できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcoursen verschillen. Kies hierboven een herhaalde race voor een gelijkwaardige vergelijking."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasy się różnią. Wybierz powyżej powtarzane zawody, aby porównać jak z jak."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os percursos mudam. Escolha acima uma prova repetida para comparar de igual para igual."
          }
        }
      }
