    "If one race was entered under a different name, search the official results database and add that registration to this profile." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ein Rennen unter einem anderen Namen gemeldet war, durchsuche die offizielle Ergebnisdatenbank und füge diese Anmeldung zu diesem Profil hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si te inscribiste en alguna carrera con otro nombre, búscalo en la base de resultados oficial y añade esa inscripción a este perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous étiez inscrit sous un autre nom pour une course, cherchez-le dans les résultats officiels et ajoutez cette inscription à ce profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a una gara eri iscritto con un altro nome, cercalo nei risultati ufficiali e aggiungi quell'iscrizione a questo profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別の名前でエントリーしたレースがある場合は、公式リザルトで検索し、その登録をこのプロフィールに追加してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stond je bij een race onder een andere naam ingeschreven? Zoek in de officiële uitslagen en voeg die inschrijving toe aan dit profiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli na któryś start zgłoszono Cię pod innym nazwiskiem, wyszukaj je w oficjalnej bazie wyników i dodaj to zgłoszenie do profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você se inscreveu em alguma prova com outro nome, busque nos resultados oficiais e adicione essa inscrição a este perfil."
          }
        }
      }
    },
