    "We couldn't find any published results under this athlete. If you registered under a different name, pick the right one." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter diesem Athleten wurden keine veröffentlichten Ergebnisse gefunden. Falls du unter einem anderen Namen gemeldet warst, wähle den richtigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No encontramos resultados publicados de este deportista. Si te inscribiste con otro nombre, elige el correcto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun résultat publié trouvé pour cet athlète. Si vous étiez inscrit sous un autre nom, choisissez le bon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non abbiamo trovato risultati pubblicati per questo atleta. Se ti sei iscritto con un altro nome, scegli quello giusto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この選手の公開リザルトが見つかりませんでした。別の名前でエントリーした場合は、正しい名前を選んでください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We vonden geen gepubliceerde uitslagen voor deze atleet. Schreef je je onder een andere naam in, kies dan de juiste."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie znaleźliśmy opublikowanych wyników tego zawodnika. Jeśli zgłoszenie było na inne nazwisko, wybierz właściwe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não encontramos resultados publicados deste atleta. Se você se inscreveu com outro nome, escolha o certo."
          }
        }
      }
    },
    "We found published results for this name, but none were full or half-distance triathlons. Try another registration if you raced under a different name." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diesen Namen gibt es veröffentlichte Ergebnisse, aber keine Lang- oder Mitteldistanz-Triathlons. Probier eine andere Anmeldung, falls du unter einem anderen Namen gestartet bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay resultados publicados con este nombre, pero ninguno de larga o media distancia. Prueba otra inscripción si competiste con otro nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des résultats existent pour ce nom, mais aucun sur longue distance ou demi-distance. Essayez une autre inscription si vous avez couru sous un autre nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci sono risultati per questo nome, ma nessuno su distanza lunga o media. Prova un'altra iscrizione se hai gareggiato con un altro nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この名前のリザルトはありますが、フル・ハーフディスタンスのトライアスロンはありませんでした。別の名前で出場した場合は、ほかの登録をお試しください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We vonden uitslagen voor deze naam, maar geen op de hele of halve afstand. Probeer een andere inschrijving als je onder een andere naam racete."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znaleźliśmy wyniki dla tego nazwiska, ale żaden nie dotyczy triathlonu na pełnym dystansie ani połówki. Jeśli zdarzyło Ci się startować pod innym nazwiskiem, spróbuj innego zgłoszenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há resultados publicados com este nome, mas nenhum de longa ou meia distância. Tente outra inscrição se você competiu com outro nome."
          }
        }
      }
    },
