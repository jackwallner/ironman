    "Name searches go to the event results service. No account is created, and race notes stay on this phone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namenssuchen gehen an den Ergebnisdienst der Veranstaltung. Es wird kein Konto erstellt, und Rennnotizen bleiben auf diesem iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las búsquedas de nombres se envían al servicio de resultados de las pruebas. No se crea ninguna cuenta y las notas no salen de este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les recherches de nom sont envoyées au service de résultats des épreuves. Aucun compte n’est créé et vos notes restent sur cet iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le ricerche per nome vanno al servizio risultati degli eventi. Non viene creato alcun account e le note restano su questo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前の検索は大会のリザルトサービスに送られます。アカウントは作成されず、レースメモはこのiPhoneに保存されたままです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoekopdrachten op naam gaan naar de uitslagendienst van de evenementen. Er wordt geen account gemaakt en notities blijven op deze iPhone."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyszukiwane nazwiska trafiają do serwisu wyników zawodów. Nie tworzymy konta, a notatki zostają na tym iPhonie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As buscas por nome vão para o serviço de resultados dos eventos. Nenhuma conta é criada e as notas ficam neste iPhone."
