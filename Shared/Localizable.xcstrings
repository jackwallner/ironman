    "Find published full and half-distance triathlon results under the name you registered with. Try your full legal first name, surname first, or add a city after a comma to narrow common names." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finde veröffentlichte Ergebnisse von Lang- und Mitteldistanz-Triathlons unter dem Namen, mit dem du gemeldet warst. Probier deinen vollen amtlichen Vornamen, den Nachnamen zuerst oder füge nach einem Komma eine Stadt hinzu, um häufige Namen einzugrenzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra resultados publicados de larga y media distancia con el nombre con el que te inscribiste. Prueba con tu nombre completo, con el apellido primero o añade una ciudad tras una coma para acotar nombres comunes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrouvez vos résultats publiés sur longue distance et demi-distance sous le nom utilisé à l’inscription. Essayez votre prénom complet, le nom en premier, ou ajoutez une ville après une virgule pour affiner les noms courants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova i risultati pubblicati su distanza lunga e media con il nome usato all'iscrizione. Prova il nome completo, il cognome per primo, oppure aggiungi una città dopo una virgola per restringere i nomi comuni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エントリー時の名前で、公開されているフル・ハーフディスタンスのリザルトを探します。ローマ字の正式な名前、姓を先に入れる、またはカンマの後に都市名を加えると、よくある名前も絞り込めます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vind gepubliceerde uitslagen op de hele en halve afstand onder de naam waarmee je je inschreef. Probeer je volledige voornaam, eerst je achternaam, of zet na een komma een plaats om veelvoorkomende namen te beperken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znajdź opublikowane wyniki triathlonów na pełnym dystansie i połówce pod nazwiskiem ze zgłoszenia. Wpisz pełne imię z dokumentu, zacznij od nazwiska lub dodaj miasto po przecinku, aby zawęzić popularne nazwiska."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontre resultados publicados de longa e meia distância com o nome usado na inscrição. Tente seu nome completo, o sobrenome primeiro, ou adicione uma cidade depois de uma vírgula para filtrar nomes comuns."
          }
        }
      }
    },
