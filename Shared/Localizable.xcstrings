    "Pattie has finished 16 full-distance triathlons. Her race-day pointers come from years of experience." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pattie hat 16 Langdistanz-Triathlons gefinisht. Ihre Tipps für den Renntag stammen aus vielen Jahren Erfahrung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pattie ha terminado 16 triatlones de larga distancia. Sus consejos para el día de carrera salen de años de experiencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pattie a terminé 16 triathlons longue distance. Ses conseils pour le jour J viennent d’années d’expérience."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pattie ha concluso 16 triathlon su distanza lunga. I suoi consigli per il giorno di gara nascono da anni di esperienza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pattieはフルディスタンスのトライアスロンを16回完走しています。レース当日のヒントは長年の経験から生まれたものです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pattie heeft 16 hele triatlons uitgelopen. Haar tips voor de racedag komen uit jarenlange ervaring."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pattie ukończyła 16 triathlonów na pełnym dystansie. Jej wskazówki na dzień startu to owoc lat doświadczeń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Pattie concluiu 16 triatlos de longa distância. Suas dicas para o dia da prova vêm de anos de experiência."
          }
        }
      }
    },
