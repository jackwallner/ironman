    "Your cached results are deleted from this phone. Your race notes are kept, and reappear if you claim the same athlete again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine zwischengespeicherten Ergebnisse werden von diesem iPhone gelöscht. Deine Rennnotizen bleiben erhalten und erscheinen wieder, wenn du denselben Athleten erneut auswählst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los resultados guardados se borran de este iPhone. Tus notas se conservan y volverán a aparecer si eliges de nuevo al mismo deportista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les résultats en cache sont supprimés de cet iPhone. Vos notes sont conservées et réapparaîtront si vous choisissez à nouveau le même athlète."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I risultati salvati vengono eliminati da questo iPhone. Le note restano e ricompariranno se scegli di nuovo lo stesso atleta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneに保存されたリザルトは削除されます。レースメモは残り、同じ選手をもう一度選ぶと再び表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bewaarde uitslagen worden van deze iPhone verwijderd. Je notities blijven en verschijnen weer als je dezelfde atleet opnieuw kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisane wyniki zostaną usunięte z tego iPhone’a. Notatki zostaną zachowane i wrócą, gdy znów wybierzesz tego samego zawodnika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os resultados salvos são apagados deste iPhone. Suas notas são mantidas e voltam a aparecer se você escolher o mesmo atleta de novo."
          }
        }
      }
    },
