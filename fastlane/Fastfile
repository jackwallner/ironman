require "json"
require "tempfile"

opt_out_usage

ASC_VALID_LANGUAGES = %w[
  ar-SA ca cs da de-DE el en-AU en-CA en-GB en-US es-ES es-MX fi fr-CA fr-FR
  he hi hr hu id it ja ko ms nl-NL no pl pt-BR pt-PT ro ru sk sv th tr uk vi
  zh-Hans zh-Hant
].freeze

default_platform(:ios)

platform :ios do
  desc "Download current metadata + screenshots from App Store Connect into /tmp/asc-live"
  lane :download_state do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    sh("rm -rf /tmp/asc-live && mkdir -p /tmp/asc-live")
    metadata_path = "/tmp/asc-live/metadata"
    screenshots_path = "/tmp/asc-live/screenshots"
    download_arguments = [
      "--api_key_path",
      nil,
      "--app_identifier",
      "com.jackwallner.ironman",
      "--app_version",
      "1.1.0",
      "--languages",
      ASC_VALID_LANGUAGES.join(","),
      "--ignore_language_directory_validation",
      "true",
      "--force",
      "true",
    ]

    Tempfile.create(["asc-api-key", ".json"]) do |key_file|
      key_file.chmod(0o600)
      key_file.write(JSON.generate(api_key))
      key_file.flush
      download_arguments[1] = key_file.path
      sh("fastlane", "deliver", "download_metadata", *download_arguments,
         "--metadata_path", metadata_path,
         "--screenshots_path", screenshots_path)
      sh("fastlane", "deliver", "download_screenshots", *download_arguments,
         "--screenshots_path", screenshots_path)
    end
  end

  desc "Fill whats_new + promotional_text on deprecated locales that ASC still requires"
  lane :fill_deprecated_locales do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    app = Spaceship::ConnectAPI::App.find("com.jackwallner.ironman")
    version = app.get_edit_app_store_version
    UI.user_error!("No editable version found") unless version

    release_notes = File.read("metadata/en-US/release_notes.txt").strip
    promo_text = File.read("metadata/en-US/promotional_text.txt").strip

    deprecated = %w[bn-BD gu-IN kn-IN ml-IN mr-IN or-IN pa-IN sl-SI ta-IN te-IN ur-PK]

    version.get_app_store_version_localizations.each do |loc|
      next unless deprecated.include?(loc.locale)
      UI.message("Filling #{loc.locale}...")
      loc.update(attributes: { whatsNew: release_notes, promotionalText: promo_text })
    end

    UI.success("All deprecated locales filled.")
  end

  desc "Upload screenshots and metadata to App Store Connect (fastlane 2.234+)"
  lane :upload_metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    version = ENV["ASC_APP_VERSION"]
    UI.user_error!("Set ASC_APP_VERSION (run: eval \"$(python3 scripts/asc-ensure-draft-version.py | grep '^export ')\")") unless version && !version.empty?

    skip_shots = ENV.fetch("SKIP_SCREENSHOTS", "false") == "true"

    deliver(
      api_key: api_key,
      app_version: version,
      languages: ASC_VALID_LANGUAGES.dup,
      skip_app_version_update: true,
      force: true,
      ignore_language_directory_validation: true,
      precheck_include_in_app_purchases: false,
      version_check_wait_retry_limit: 7,
      skip_binary_upload: true,
      skip_screenshots: skip_shots,
      overwrite_screenshots: !skip_shots,
      app_rating_config_path: File.expand_path("metadata/app_rating_config.json", __dir__),
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      app_review_information: {
        first_name: "Jack",
        last_name: "Wallner",
        email: "jackwallner@gmail.com",
        demo_user: "N/A, no login or account system",
        demo_password: "",
        notes: <<~NOTES
          IM Iron Splits is a read-only viewer for published full and half-distance
          triathlon results. There are no accounts or sign-in.

          Core flow:
          1. Launch to Athlete Search. Search "Daniel Winek" and select the
             public result set.
          2. After claiming, the Locker shows published results. Switch between Races and
             Rankings; rankings keep full and half distance separate.
          3. Open a race for official splits, division and overall places, and
             field context.
          4. Explore searches another athlete without changing the Locker.
          5. Race Book shows free career totals, personal bests and progression.
             Compare and export actions open the in-app purchase sheet.
          6. Settings contains Restore Purchases.

          Search supports full registered names. Common names can be narrowed
          with a city or state after a comma. The broad fallback explains its
          longer wait and can be stopped.

          Search, complete supported history, rankings, personal bests,
          progression, field context, notes and race details are free. Race Book
          is a one-time lifetime purchase for like-for-like comparison and
          unlimited PDF/image export. There is no subscription or per-export
          charge.

          Data: name searches and public contact/event identifiers are sent to
          the timing service to request results. Race notes stay on the device.
          RevenueCat processes purchase and restore details and limited
          purchase-screen counts tied to an anonymous app user ID. It receives
          no names, race results or notes.

          The app is independent and is not affiliated with or endorsed by any
          race organiser or timing company. Screenshots use fictional sample
          results; the in-app search flow can use the public sample profile above.
        NOTES
      },
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end

  desc "Submit the draft version for App Store review (metadata already uploaded)"
  lane :submit_review do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    version = ENV["ASC_APP_VERSION"]
    UI.user_error!("Set ASC_APP_VERSION") unless version && !version.empty?
    build_number = ENV["ASC_BUILD_NUMBER"]
    UI.user_error!("Set ASC_BUILD_NUMBER") unless build_number && !build_number.empty?

    deliver(
      api_key: api_key,
      app_version: version,
      build_number: build_number,
      skip_app_version_update: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      app_rating_config_path: File.expand_path("metadata/app_rating_config.json", __dir__),
      force: true,
      # Matches upload_metadata. The 11 deprecated locale directories are still
      # required by ASC but rejected by deliver's validator, and this lane
      # uploads no metadata anyway, so the directory check has nothing to guard.
      ignore_language_directory_validation: true,
      submit_for_review: true,
      # Manual release. The price ladder changes on its own schedule, so an
      # approval must never put a version on sale by itself.
      automatic_release: false,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
  end
end
